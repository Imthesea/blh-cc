{
  "name": "blh",
  "version": "0.1.0",
  "description": "blh — a coding agent CLI (TypeScript)",
  "type": "module",
  "bin": {
    "blh": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
